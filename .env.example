# Local development database from docker-compose.yml
DATABASE_URL=postgresql+psycopg://job_radar:job_radar_password@localhost:5434/job_radar

# Web server port used by the production container entry point
PORT=8080

# Optional docker-compose override. Containers use postgres:5432,
# while host processes use localhost:5434 above.
DOCKER_DATABASE_URL=postgresql+psycopg://job_radar:job_radar_password@postgres:5432/job_radar
